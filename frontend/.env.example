# PulseChat Frontend Environment Variables (Vite)
# Copy this file to .env for local configuration

# Backend REST API Base URL
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5000

# Development Sandbox Mode
# Set to 'true' to allow graceful fallback to simulated mock socket behavior when backend is offline.
# Set to 'false' in production to strictly enforce real backend WebSocket connectivity.
VITE_ENABLE_MOCK_FALLBACK=true

# Socket Reconnection Parameters
VITE_SOCKET_RECONNECT_ATTEMPTS=5
VITE_SOCKET_RECONNECT_DELAY=2000
