# PulseChat Backend Configuration Template
# Duplicate this file as .env for local development
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String Options:
# Option 1: Local MongoDB instance (default port 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/pulsechat

# Option 2: MongoDB Atlas Cloud Cluster
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/pulsechat?retryWrites=true&w=majority
