{
  "name": "pulsechat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UandMe (PulseChat) - Real-Time Messaging & WebRTC Calling Platform (Fullstack Monorepo)",
  "workspaces": [
    "backend",
    "frontend",
    "apps/*"
  ],
  "scripts": {
    "start": "node backend/src/server.js",
    "build": "npm install --prefix backend",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:hellotalk": "npm run dev --prefix apps/hellotalk",
    "build:frontend": "npm run build --prefix frontend",
    "build:hellotalk": "npm run build --prefix apps/hellotalk",
    "test:backend": "npm test --prefix backend",
    "test:backend:watch": "npm run test:watch --prefix backend",
    "test:backend:coverage": "npm run test:coverage --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
